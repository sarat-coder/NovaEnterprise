# ============================================================
# NovaEnterprise — environment variables
# Copy this file to .env and fill in real values.
# Never commit .env to git.
# ============================================================

# --- AI provider (default: fake — no API key needed) ---
LLM_PROVIDER=fake
# Options: fake | openai | anthropic | azure | google | cohere | mistral | ollama
LLM_API_KEY=
LLM_MODEL=

EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL=

# --- Vector store (default: memory — no Docker needed) ---
VECTOR_STORE=memory
# VECTOR_STORE=qdrant
QDRANT_URL=
QDRANT_API_KEY=

# --- Graph store (default: memory — no Docker needed) ---
GRAPH_STORE=memory
# GRAPH_STORE=neo4j
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# --- Database (default: SQLite) ---
DATABASE_URL=sqlite:///data/enterprise.db
# For Postgres / Supabase:
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/nova

# --- Redis (empty → fakeredis, no Docker needed) ---
REDIS_URL=
# REDIS_URL=redis://localhost:6379/0

# --- Workflow tuning ---
MAX_SUBQUESTIONS=4
MAX_CORRECTIVE_ROUNDS=1

# --- Rate limiting ---
RATE_LIMIT_PER_MINUTE=120

# --- Uploads ---
MAX_UPLOAD_MB=5

# --- Auth ---
JWT_SECRET=change-me-before-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# --- Supabase (optional — only needed for Supabase Auth + RLS) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- CORS ---
CORS_ORIGINS=http://localhost:3001

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
