# ============================================================
# NovaEnterprise .gitignore
# Never commit: .env, data/, *.db, or any real key (CLAUDE.md §15 rule 11)
# ============================================================

# ---------- Secrets and environment ----------
.env
.env.*
!.env.example
*.pem
*.key
*.crt
secrets/
credentials.json
service-account*.json

# ---------- Python-generated files ----------
__pycache__/
*.py[oc]
*.pyd
*.so
build/
dist/
wheels/
*.egg-info
*.egg
.eggs/
pip-wheel-metadata/

# ---------- Virtual environments (uv) ----------
.venv
venv/
env/
# uv.lock is committed on purpose: reproducible installs

# ---------- Lint, type check, and test caches ----------
.ruff_cache/
.mypy_cache/
.pytype/
.pyre/
.pytest_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
junit*.xml
test-results/

# ---------- Local data and databases ----------
data/
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm
dump.rdb

# ---------- Local store volumes (Docker Compose) ----------
neo4j/data/
neo4j/logs/
neo4j/import/
qdrant_storage/
qdrant/storage/
postgres-data/
redis-data/
volumes/

# ---------- Uploads and generated artifacts ----------
uploads/
tmp/
*.tmp
logs/
*.log

# ---------- Evaluation outputs (dataset under tests/evaluation/datasets is committed) ----------
tests/evaluation/results/
tests/evaluation/reports/

# ---------- Frontend (Next.js 15) ----------
node_modules/
.next/
out/
frontend/build/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------- Terraform / infra ----------
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
crash.log

# ---------- Jupyter ----------
.ipynb_checkpoints/

# ---------- Claude Code / Cursor local settings ----------
.claude/settings.local.json
.cursor/*.local.*
/.claude/settings.local.json
/.claude/agent-calls.jsonl
/CLAUDE.local.md
/.claude.bak-*/

# ---------- IDE / editor ----------
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# ---------- OS ----------
.DS_Store
Thumbs.db
desktop.ini
